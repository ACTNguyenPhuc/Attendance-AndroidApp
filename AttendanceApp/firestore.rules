rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isClassTeacher(classId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/classes/$(classId)).data.teacherId
               == request.auth.uid;
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // Dữ liệu sau khi toàn bộ transaction tự đóng phiên được áp dụng.
    function sessionDataAfter(sessionId) {
      return getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // ── Classes ──────────────────────────────────────────────────────────────
    match /classes/{classId} {
      // Anyone authenticated can read (students need to see class info)
      allow read: if request.auth != null;
      // Only the teacher who created it can write
      allow create: if request.auth != null &&
                       request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null &&
                               resource.data.teacherId == request.auth.uid;
    }
    // ── Shifts ───────────────────────────────────────────────────────────────
    match /shifts/{shiftId} {
      allow read: if request.auth != null;
      // A new shift has no stored document; authorize from the incoming classId.
      allow create: if request.auth != null &&
                      get(/databases/$(database)/documents/classes/$(request.resource.data.classId))
                        .data.teacherId == request.auth.uid;
      // A shift stays with its original class; only that class's teacher may change it.
      allow update: if (request.auth != null &&
                        request.resource.data.classId == resource.data.classId &&
                        get(/databases/$(database)/documents/classes/$(resource.data.classId))
                          .data.teacherId == request.auth.uid) ||
                    // Thiết bị sinh viên chỉ được chuyển ca sang completed khi
                    // cùng transaction đã đóng đúng phiên và đã qua giờ server.
                    (isSignedIn() &&
                     resource.data.attendanceOpened == true &&
                     request.resource.data.attendanceOpened == false &&
                     request.resource.data.status == 'completed' &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'attendanceOpened']) &&
                     resource.data.attendanceSessionId is string &&
                     sessionDataAfter(resource.data.attendanceSessionId).shiftId == shiftId &&
                     sessionDataAfter(resource.data.attendanceSessionId).active == false &&
                     sessionDataAfter(resource.data.attendanceSessionId).scheduledEndTime is timestamp &&
                     request.time >= sessionDataAfter(resource.data.attendanceSessionId).scheduledEndTime);
      allow delete: if request.auth != null &&
                      get(/databases/$(database)/documents/classes/$(resource.data.classId))
                        .data.teacherId == request.auth.uid;
    }
    // ── Sessions ─────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isClassTeacher(request.resource.data.classId) &&
                       request.resource.data.scheduledEndTime is timestamp;

      allow update: if (isSignedIn() &&
                        request.resource.data.classId == resource.data.classId &&
                        isClassTeacher(resource.data.classId)) ||
                    // Ngoại lệ duy nhất cho sinh viên: true -> false sau khi hết
                    // giờ; serverTimestamp bắt buộc phải bằng request.time.
                    (isSignedIn() &&
                     resource.data.active == true &&
                     request.resource.data.active == false &&
                     resource.data.scheduledEndTime is timestamp &&
                     request.time >= resource.data.scheduledEndTime &&
                     request.resource.data.endTime == request.time &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['active', 'endTime']));

      allow delete: if isClassTeacher(resource.data.classId);
    }
    // ── Attendances ──────────────────────────────────────────────────────────
    match /attendances/{attendanceId} {
      // Anyone authenticated can read (teacher sees all, student sees own)
      allow read: if request.auth != null;
      // Students create their own attendance record
      allow create: if request.auth != null &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status in ['present', 'late'] &&
                       sessionData(request.resource.data.sessionId).active == true &&
                       sessionData(request.resource.data.sessionId).scheduledEndTime is timestamp &&
                       request.time < sessionData(request.resource.data.sessionId).scheduledEndTime &&
                       sessionData(request.resource.data.sessionId).classId
                         == request.resource.data.classId &&
                       sessionData(request.resource.data.sessionId).shiftId
                         == request.resource.data.shiftId;
      // No updates/deletes by students; teachers can update (e.g. mark absent)
      allow update: if request.auth != null;
      allow delete: if false;
    }
    // ── Enrollments ──────────────────────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      // A student can join personally, or the class teacher can add a student manually.
      allow create: if request.auth != null &&
                      (request.resource.data.studentId == request.auth.uid ||
                       get(/databases/$(database)/documents/classes/$(request.resource.data.classId))
                         .data.teacherId == request.auth.uid);
      // Only the owning teacher may edit an enrollment.
      allow update: if request.auth != null &&
                      get(/databases/$(database)/documents/classes/$(resource.data.classId))
                        .data.teacherId == request.auth.uid;
      // Students can leave themselves; the owning teacher can remove them.
      allow delete: if request.auth != null &&
                      (resource.data.studentId == request.auth.uid ||
                       get(/databases/$(database)/documents/classes/$(resource.data.classId))
                         .data.teacherId == request.auth.uid);
    }
  }
}
