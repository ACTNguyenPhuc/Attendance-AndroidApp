<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/primary_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_avatar_initial"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:text="A"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_circle_white_border" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SINH VIÊN"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_badge_white_outline" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_header_logout"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/logout"
                android:padding="12dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- TÀI KHOẢN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="TÀI KHOẢN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/row_personal_info"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_person" app:tint="@color/primary_blue"
                        android:contentDescription="Thông tin cá nhân" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thông tin cá nhân" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Xem và chỉnh sửa thông tin" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="64dp" />

                <LinearLayout android:id="@+id/row_change_password"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_lock" app:tint="@color/primary_blue"
                        android:contentDescription="@string/change_password" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/change_password" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/change_password_description" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="64dp" />

                <LinearLayout android:id="@+id/row_personal_qr"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_qr" app:tint="@color/primary_blue"
                        android:contentDescription="Mã QR cá nhân" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mã QR cá nhân" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mã định danh của bạn" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CÀI ĐẶT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="CÀI ĐẶT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_bell" app:tint="@color/primary_blue"
                        android:contentDescription="Thông báo" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thông báo" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nhận thông báo điểm danh" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_notification"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="64dp" />

                <LinearLayout android:id="@+id/row_reminder_time"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_clock" app:tint="@color/primary_blue"
                        android:contentDescription="Nhắc trước ca học" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nhắc trước ca học" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tv_reminder_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Trước 15 phút" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="64dp" />

                <LinearLayout android:id="@+id/row_language"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_language" app:tint="@color/primary_blue"
                        android:contentDescription="Ngôn ngữ" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ngôn ngữ" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tiếng Việt" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HỖ TRỢ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="HỖ TRỢ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/row_help"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_help" app:tint="@color/primary_blue"
                        android:contentDescription="Trợ giúp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Trợ giúp" android:textSize="15sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="64dp" />

                <LinearLayout android:id="@+id/row_about"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_square_blue" android:padding="8dp"
                        android:src="@drawable/ic_info_circle" app:tint="@color/primary_blue"
                        android:contentDescription="Về ứng dụng" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Về ứng dụng" android:textSize="15sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Phiên bản 1.0.0" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="32dp"
            android:text="ĐĂNG XUẤT"
            android:textColor="@color/error_red"
            android:textStyle="bold"
            app:strokeColor="@color/error_red"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/error_red"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
