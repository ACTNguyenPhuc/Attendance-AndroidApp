<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ngày học -->
        <TextView
            android:id="@+id/tv_date_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ngày học" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_outlined_field"
            android:paddingHorizontal="12dp"
            android:text="Chọn ngày"
            android:textColor="@color/text_primary" android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Ca học -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ca học" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_shift"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Chọn ca học"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_shift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phòng học bắt buộc -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_room"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Phòng học"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_room"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ghi chú (tùy chọn) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Ghi chú (tùy chọn)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
