# Sao chép file này thành ../.env (thư mục gốc repo) rồi điền giá trị thật.
# .env đã được .gitignore chặn — KHÔNG BAO GIỜ commit.

# Nơi chạy mô hình: ollama (máy chủ của mình, mặc định) | gemini (API Google)
LLM_PROVIDER=ollama
# Provider dự phòng khi provider chính lỗi (Ollama tắt, Gemini cạn quota...). Để trống = tắt.
# Chỉ tự chuyển khi lượt hỏi chưa gọi tool nào, nên không bao giờ ghi dữ liệu hai lần.
# LLM_FALLBACK=gemini

# ── Ollama ──
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Dùng bản *instruct*: tag qwen3:4b trần là bản Thinking, luôn suy nghĩ ~1500 token
# trước mỗi câu trả lời (chậm ~80s/lượt trên GPU 4 GB) và bỏ qua think=false.
# Ollama mặc định cắt ngữ cảnh rất ngắn mà không báo — phải đặt rõ.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# ── Gemini (chỉ cần khi LLM_PROVIDER=gemini) ──
# Lấy tại https://aistudio.google.com/apikey  (gói miễn phí)
GOOGLE_API_KEY=

# Tùy chọn — mặc định đã trỏ sẵn tới AttendanceApp/serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=
